# 构建产物（docs/build.md §2：构建目录 build/）
build/
*.o
*.a
*.so
__pycache__/
*.pyc

# 模型权重本体（不入库；权重哈希与版本以 config.yaml 与主基准 §10.4 `model.*` 为准）
models/*.rknn
models/*.onnx
models/*.pt
models/*.pth
models/**/*.rknn
models/**/*.onnx
models/**/*.pt
models/**/*.pth

# 证据报告中的大张量中间产物（可由 docs/evidence 记录的复现命令重生成，不入库）
docs/evidence/reports/**/*.npy
# 同上：裸张量/裸图中间产物（曲线场 .f32、RGB888 帧 .rgb 等），同属可重生成项
docs/evidence/reports/**/*.f32
docs/evidence/reports/**/*.rgb

# rknn-toolkit2 在**当前工作目录**留下的内部 onnx 优化中间文件（实测：每次 build 都会生成）
*_optimize.onnx
# 同理：2.3.2 还会留下 check*_ops.onnx（本目录 build 时实测）
check*_ops.onnx

# 量化校准集图像（代用集由 M0-8/M1 的采集流程生成，不入库；清单与复现命令见证据文档）
models/**/calib*/

# 日志与临时文件（日志规格见 docs/logging.md；板上 storage.dir 与 logging.dir 均不在本仓库）
*.log
*.tmp
.DS_Store

# 例外：证据目录下的构建/探测原始日志属证据，必须入库（规则 10-evidence §4）
!docs/evidence/reports/**/*.log

# IDE 私有配置（工程级纪律与工具在 .trae/，必须入库，不在此列）
.vscode/
.idea/

# 板上运行期产物（存图目录在演示板上，见主基准 §8.3）
storage/

# 参考资料库（外部归档与厂商资料，非工程资产，不入库）
#   refs/Img_Enchance_Demo_explore.zip  3588 出厂资料归档（3.73 GiB，含前身工作区）
#   refs/野火鲁班猫/                     鲁班猫（野火）官方开发板资料
refs/