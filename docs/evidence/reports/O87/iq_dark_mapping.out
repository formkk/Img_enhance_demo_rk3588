# O87 ISP 暗部映射只读核查（collect 档 IQ）
# 文件: /etc/iqfiles/imx415_CMK-OT2022-PX1_IR0147-50IRC-8M-F20.json

== 暗部相关模块使能 ==
  ablc_calib         enable=1; enable=0
  adrc_calib_v11     Enable=0
  agamma_calib_v11   Gamma_en=1
  bayer2dnr_v2       enable=1; hdrdgain_ctrl_en=1
  bayertnr_v2        enable=0
  ynr_v3             enable=1
  cnr_v2             enable=1
  sharp_v4           enable=1; kernel_sigma_enable=0
  gain_v2            hdrgain_ctrl_enable=1

== gamma 曲线（agamma_calib_v11） ==
  Gamma_en = 1  Gamma_out_offset = 0
  n=49  值域 0..4095  输入步长(按 12bit)=85.3
  曲线: [0, 93, 128, 154, 175, 194, 211, 226, 240, 266, 289, 310, 329, 365, 396, 425, 451, 499, 543, 582, 618, 684, 744, 798, 848, 938, 1019, 1093, 1161, 1285, 1396, 1498, 1592, 1761, 1914, 2052, 2181, 2414, 2622, 2813, 2989, 3153, 3308, 3454, 3593, 3727, 3854, 3977, 4095]
  暗部斜率(相对线性=1.00): 段1=1.09 段2=0.41 段3=0.30 段4=0.25 段5=0.22 段6=0.20 段7=0.18 段8=0.16 段9=0.30
  高光斜率(后 8 段): 段41=1.92 段42=1.82 段43=1.71 段44=1.63 段45=1.57 段46=1.49 段47=1.44 段48=1.38

== 判定 ==
  adrc Enable=0 ⇒ 「DRC 暗部数字拉伸放大噪声」假设证伪
  gamma 暗部斜率 0.16~0.30（压缩）、高光 1.4~1.9（放大）⇒ 「gamma 拉伸暗部」假设亦证伪
  2DNR 开 / 3DNR 关 ⇒ 空间高频被抹平（高通口径 σ 小）、帧间噪声保留（时域口径 σ 大）——与实测自洽
  ⇒ 「时域 σ_eff 随照度降低而升高」成因未定：登记为现象 + 待查（不得写成结论）
